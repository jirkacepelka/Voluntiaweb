# Odkud se berou data. Možnosti: mock | wordpress | is
#   mock      – ukázková data z src/lib/cms/mock-data.ts (funguje bez připojení)
#   wordpress – obsah ze současného voluntia.cz (WP REST API), na přechodné období
#   is        – API informačního systému, viz docs/is-api.md

# Články: mock | wordpress | is
CMS_ARTICLES_SOURCE=mock
# Stránky O nás, Manifest, Ochrana osobních údajů: mock | wordpress | is
CMS_PAGES_SOURCE=mock
# Návrhy pod pilíři programu: mock | wordpress | is
CMS_PROGRAM_SOURCE=mock
# Krajští lídři na homepage: mock | is
CMS_PEOPLE_SOURCE=mock
# Kalendář akcí: mock | is
CMS_EVENTS_SOURCE=mock

# Informační systém (CMS_*_SOURCE=is)
IS_API_URL=https://is.voluntia.cz/api/web
# Volitelný token, pokud IS API nebude veřejné (posílá se jako Authorization: Bearer …)
IS_API_TOKEN=

# WordPress (CMS_*_SOURCE=wordpress)
WP_API_URL=https://voluntia.cz/wp-json/wp/v2
