---
// Patička ve stylu hero: tečkovaná mřížka, šedá značka v pozadí, logo IALP (členství)
// a sloupce odkazů jako v IS.
import Icon from './Icon.astro';
import SocialIcons from './SocialIcons.astro';
import VoluntiaMark from './VoluntiaMark.astro';
import { contact, existing, links, pages } from '../config';
import { isExternalHref } from '../lib/external-links';

// Názvy položek sdílí s horní lištou (`pages` v config.ts).
const columns = [
  { title: 'Strana', items: [pages.about, pages.program, pages.manifest, pages.values, pages.people, pages.contact] },
  { title: 'Zapojte se', items: [{ label: 'Jak se zapojit', href: links.getInvolved }, pages.join, pages.donate, pages.discord, pages.forum, pages.beer, pages.events] },
  { title: 'Informace', items: [pages.news, pages.transparency, pages.press, pages.statutes, pages.privacy] },
].map((c) => ({ ...c, items: existing(c.items) }));
---

<footer class="footer">
  <div class="footer__dots" aria-hidden="true"></div>
  <VoluntiaMark class="footer__mark" />

  <div class="container footer__inner">
    <div class="footer__grid">
      <a class="footer__ialp" href={links.ialp}>
        <img src="/ialp-logo.png" alt="IALP" width="150" height="120" loading="lazy" />
        <span>Jsme členy IALP – Mezinárodní aliance libertariánských stran</span>
      </a>

      {
        columns.map((col) => (
          <nav class="footer__col" aria-label={col.title}>
            <h2>{col.title}</h2>
            <ul>
              {col.items.map((i) => (
                <li>
                  <a href={i.href}>
                    {i.label}
                    {isExternalHref(i.href) && <Icon name="ArrowUpRight" size={14} />}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} {contact.name} · IČ {contact.ico}</span>
      <div class="footer__bottom-right">
        <a href={links.join}>Portál člena <Icon name="ArrowUpRight" size={14} /></a>
        <SocialIcons size={22} class="footer__socials" />
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--black);
    padding: 64px 0 32px;
  }

  @media (min-width: 48em) {
    .footer {
      padding: 96px 0 40px;
    }
  }

  /* Stejná tečkovaná mřížka jako v hero, mizí k okrajům. */
  .footer__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1.2px, transparent 1.6px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 60% 70% at 85% 30%, #000 20%, transparent 100%);
    pointer-events: none;
  }

  .footer :global(.footer__mark) {
    position: absolute;
    right: -110px;
    top: 40px;
    width: 420px;
    height: auto;
    color: #3a3a3a;
    opacity: 0.35;
    transform: rotate(-10deg);
    pointer-events: none;
  }

  .footer__inner {
    position: relative;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 24px;
  }

  @media (min-width: 62em) {
    .footer__grid {
      grid-template-columns: 1.5fr repeat(3, 1fr);
      gap: 48px;
    }
  }

  /* Členství v IALP – jejich logo bez pozadí a krátký popisek. */
  .footer__ialp {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    max-width: 260px;
    color: var(--muted);
    font-size: var(--fs-note);
    line-height: 1.4;
    transition: color var(--dur) var(--ease);
  }

  .footer__ialp img {
    display: block;
    width: 110px;
    height: auto;
  }

  .footer__ialp:hover {
    color: var(--text-soft);
    text-decoration: none;
  }

  @media (min-width: 62em) {
    .footer__ialp {
      grid-column: auto;
    }
  }

  .footer__col h2 {
    margin: 0 0 16px;
    font-size: var(--fs-note);
    font-weight: 600;
    color: var(--dim);
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-soft);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .footer__col a:hover {
    color: var(--yellow);
    text-decoration: none;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: var(--fs-note);
    color: var(--dim);
  }

  .footer__bottom a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
  }

  .footer__bottom a:hover {
    color: var(--yellow);
    text-decoration: none;
  }

  .footer__bottom-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }

  .footer__bottom-right :global(.footer__socials) {
    gap: 2px;
  }

  @media (max-width: 39.99em) {
    .footer :global(.footer__mark) {
      width: 240px;
      right: -90px;
    }
  }
</style>
