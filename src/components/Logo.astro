---
// Logo Voluntia – Libertariánská strana (stejný soubor jako na statnidluh.voluntia.cz).
interface Props {
  variant?: 'yellow' | 'white';
  height?: number;
}
const { variant = 'yellow', height = 50 } = Astro.props;
const src = variant === 'yellow' ? '/logo-voluntia-yellow.svg' : '/logo-voluntia.svg';
---

<img class="logo" src={src} alt="Voluntia – Libertariánská strana" width={Math.round((height * 200) / 55)} height={height} />

<style>
  .logo {
    display: block;
    width: auto;
  }
</style>
