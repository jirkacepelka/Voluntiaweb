---
// Ikony Lucide (stejná sada jako IS a statnidluh), vložené přímo do HTML.
import * as icons from 'lucide-static';

interface Props {
  name: keyof typeof icons;
  size?: number | string;
  class?: string;
}

const { name, size = '1em', class: className } = Astro.props;
const svg = String(icons[name])
  .replace(/class="[^"]*"/, `class="ico${className ? ` ${className}` : ''}" aria-hidden="true"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`);
---

<Fragment set:html={svg} />
