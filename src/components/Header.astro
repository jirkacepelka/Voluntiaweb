---
// Horní lišta podle IS (.p-header: černá, 80 px) se strukturou z návrhu ve Frameru:
// hlavní položky, rozbalovací menu „Více“ na celou šířku a tlačítko Přispět.
// Mobil: nižší lišta s Přispět vedle hamburgeru (bez JS, zaškrtávátko); menu přes celou
// obrazovku, skupiny z „Více“ jsou v něm rovnou rozbalené.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { links, nav, navMore } from '../config';

const path = Astro.url.pathname;
const isCurrent = (href: string) => href.startsWith('/') && !href.includes('#') && href !== '/' && path.startsWith(href);
---

<header class="p-header">
  <div class="container p-header__inner">
    <a class="p-header__logo" href="/" aria-label="Voluntia – úvodní stránka"><Logo height={50} /></a>

    <a class="btn btn--light p-header__cta" href={links.donate}>Přispět</a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label">
      <span class="sr-only">Menu</span>
      <Icon name="Menu" size={28} class="ico-menu" />
      <Icon name="X" size={28} class="ico-x" />
    </label>

    <nav class="p-nav" aria-label="Hlavní navigace">
      <ul class="p-nav__main">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="p-nav__more-item">
          <button class="p-nav__more" type="button" aria-expanded="false" aria-controls="nav-more">
            Více <Icon name="ChevronDown" size={18} class="p-nav__chevron" />
          </button>
        </li>
        <li class="p-nav__cta"><a class="btn btn--light" href={links.donate}>Přispět</a></li>
      </ul>

      <div class="mega" id="nav-more">
        <div class="container mega__cols">
          {
            navMore.map((group) => (
              <div class="mega__group">
                <h2>{group.title}</h2>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a href={item.href}>{item.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.p-header');
  const more = document.querySelector<HTMLButtonElement>('.p-nav__more');
  const toggle = document.getElementById('nav-toggle') as HTMLInputElement | null;

  const setMore = (open: boolean) => {
    more?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-more-open', open);
  };

  more?.addEventListener('click', () => setMore(more.getAttribute('aria-expanded') !== 'true'));

  // Zavření klávesou Esc (jako public.js v IS) a kliknutím mimo lištu.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (more?.getAttribute('aria-expanded') === 'true') {
      setMore(false);
      more.focus();
    }
    if (toggle?.checked) toggle.checked = false;
  });
  // Odkaz v mobilním menu (i kotva na téže stránce) menu zavře.
  document.querySelectorAll('.p-nav a').forEach((a) =>
    a.addEventListener('click', () => {
      if (toggle) toggle.checked = false;
    }),
  );
  document.addEventListener('click', (e) => {
    if (header && !header.contains(e.target as Node)) setMore(false);
  });
</script>

<style>
  .p-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--black);
  }
  .p-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: var(--header-h);
  }

  /* ── Mobil ─────────────────────────────────────────────── */
  .p-header__logo :global(.logo) {
    height: 40px;
  }
  .p-header__cta {
    height: 38px;
    margin-left: auto;
    padding: 0 16px;
    font-size: 15px;
  }
  .nav-toggle {
    display: none;
  }
  .nav-toggle-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0 -10px 0 -8px;
    color: var(--white);
    cursor: pointer;
  }
  .nav-toggle-label :global(.ico-x),
  .nav-toggle:checked ~ .nav-toggle-label :global(.ico-menu) {
    display: none;
  }
  .nav-toggle:checked ~ .nav-toggle-label :global(.ico-x) {
    display: inline-block;
  }
  .p-nav {
    display: none;
  }
  /* Otevřené menu zabere celou obrazovku pod lištou a scrolluje samo (stránka pod ním stojí). */
  .nav-toggle:checked ~ .p-nav {
    display: block;
    position: fixed;
    left: 0;
    right: 0;
    top: var(--header-h);
    bottom: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--black);
    border-top: 1px solid var(--border);
    padding: 8px 0 calc(32px + env(safe-area-inset-bottom));
    animation: nav-in 220ms var(--ease);
  }
  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .p-nav__main {
    display: flex;
    flex-direction: column;
    padding: 0 var(--gutter);
  }
  .p-nav a:not(.btn) {
    color: var(--white);
    font-size: var(--fs-nav);
    font-weight: 500;
    transition: color var(--dur) var(--ease);
  }
  .p-nav__main li:not(.p-nav__cta) {
    border-bottom: 1px solid var(--border);
  }
  .p-nav__main a:not(.btn) {
    display: block;
    padding: 14px 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .p-nav a:not(.btn):hover,
  .p-nav a:not(.btn)[aria-current] {
    color: var(--yellow);
    text-decoration: none;
  }
  /* Přispět je na mobilu přímo v liště. */
  .p-nav__more-item,
  .p-nav__cta {
    display: none;
  }

  /* Skupiny z „Více“ – na mobilu rovnou vidět, menší a ve dvou sloupcích. */
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 20px;
    padding-top: 28px;
  }
  .mega__group h2 {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mega__group ul {
    display: flex;
    flex-direction: column;
  }
  .mega__group a:not(.btn) {
    display: block;
    padding: 6px 0;
    color: var(--text-soft);
  }

  /* ── Desktop ───────────────────────────────────────────── */
  @media (min-width: 62em) {
    .nav-toggle-label,
    .p-header__cta {
      display: none;
    }
    .p-header__logo :global(.logo) {
      height: 50px;
    }
    .p-nav,
    .nav-toggle:checked ~ .p-nav {
      display: block;
      position: static;
      max-height: none;
      overflow: visible;
      border: 0;
      padding: 0;
      background: none;
      animation: none;
    }
    .p-nav__main {
      flex-direction: row;
      align-items: center;
      gap: 22px;
      padding: 0;
    }
    .p-nav__main li:not(.p-nav__cta) {
      border: 0;
    }
    .p-nav__main a:not(.btn) {
      padding: 0;
      font-size: var(--fs-nav);
      font-weight: 500;
      letter-spacing: normal;
    }
    .p-nav__more-item,
    .p-nav__cta {
      display: block;
    }
    .p-nav__more {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--white);
      font: inherit;
      font-size: var(--fs-nav);
      font-weight: 500;
      cursor: pointer;
    }
    .p-nav__more:hover,
    .p-nav__more[aria-expanded='true'] {
      color: var(--yellow);
    }
    .p-nav__more {
      transition: color var(--dur) var(--ease);
    }
    .p-nav__more :global(.p-nav__chevron) {
      transition: transform var(--dur) var(--ease);
    }
    .p-nav__more[aria-expanded='true'] :global(.p-nav__chevron) {
      transform: rotate(180deg);
    }

    /* Menu „Více“ přes celou šířku pod lištou – plynule se prolne, neskočí.
       `visibility` ho po zavření skryje i pro klávesnici a čtečky. */
    .mega {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      margin: 0;
      background: var(--black);
      border-top: 1px solid var(--border);
      box-shadow: 0 24px 40px rgb(0 0 0 / 0.45);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition:
        opacity var(--dur) var(--ease),
        transform var(--dur) var(--ease),
        visibility 0s linear var(--dur);
    }
    .p-header.is-more-open .mega {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
    .mega__group h2 {
      font-size: var(--fs-body);
      letter-spacing: normal;
      text-transform: none;
      color: var(--white);
    }
    .mega__group a:not(.btn) {
      padding: 5px 0;
      font-size: var(--fs-small);
    }
    .mega__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px;
      padding-top: 32px;
      padding-bottom: 32px;
    }
  }
  /* Na širších obrazovkách víc vzduchu mezi položkami (na užších se jich 6 musí vejít). */
  @media (min-width: 75em) {
    .p-nav__main {
      gap: 34px;
    }
  }
</style>
