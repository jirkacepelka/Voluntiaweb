---
// Menší karta článku do postranního sloupce: náhled vlevo, datum a titulek vpravo.
// Bez rámečku jako velké karty článků; titulek se při najetí podtrhne zleva doprava.
import { Image } from 'astro:assets';
import type { Article } from '../lib/cms';
import { formatDate } from '../lib/format';

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<a class="mini" href={`/clanky/${article.slug}/`}>
  {
    article.cover ? (
      <span class="thumb mini__thumb">
        <Image src={article.cover.url} alt="" width={article.cover.width ?? 1200} height={article.cover.height ?? 675} widths={[140, 280]} sizes="140px" />
      </span>
    ) : (
      <span class="thumb thumb--empty mini__thumb" aria-hidden="true">
        <span>
          <img class="mini__mark" src="/logo-voluntia.svg" alt="" width="200" height="55" />
        </span>
      </span>
    )
  }
  <span class="mini__body">
    <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
    <span class="mini__title"><span class="underline">{article.title}</span></span>
  </span>
</a>

<style>
  .mini {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    color: var(--white);
  }
  .mini:hover {
    text-decoration: none;
  }
  .mini__thumb {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
  }
  .mini__mark {
    width: 60%;
    height: auto;
    filter: brightness(0);
  }
  .mini__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  time {
    font-size: 13px;
    color: var(--muted);
  }
  .mini__title {
    display: -webkit-box;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
