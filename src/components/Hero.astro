---
// Hero: vlevo heslo a tlačítka, vpravo skupinová fotka (vyříznutá, průhledné pozadí),
// pozadí z Frameru (tečkovaná mřížka, naklopené značky), pod tím tři karty ve stylu statnidluh.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SocialIcons from './SocialIcons.astro';
import VoluntiaMark from './VoluntiaMark.astro';
import { debt, heroStats, links } from '../config';
import { formatNumber } from '../lib/format';
import people from '../assets/hero/lide.png';
---

<section class="hero">
  <div class="hero__dots" aria-hidden="true"></div>
  <VoluntiaMark class="mark mark--yellow" />
  <VoluntiaMark class="mark mark--grey" />

  <div class="container hero__inner">
    <div class="hero__intro">
      <a class="hero__news" href={links.magistrat}>
        <span class="hero__news-tag">Nově</span>
        Kandidujeme na pražský magistrát
        <Icon name="ArrowRight" size={16} />
      </a>
      <h1 class="hero__title">Méně státu, <span>více svobody</span></h1>
      <div class="hero__actions">
        <a class="btn btn--primary" href={links.program}>Náš program</a>
        <a class="btn btn--light" href={links.getInvolved}>Zapojte se</a>
      </div>
      <SocialIcons size={32} class="hero__socials" />
    </div>

    <div class="hero__people">
      <Image
        src={people}
        alt="Tři představitelé Voluntie"
        widths={[640, 960, 1280]}
        sizes="(min-width: 62em) 560px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="hero__cards">
      {
        heroStats.map((s) => {
          // Karta bez cílové stránky (href '#') je jen informační, ne odkaz.
          const Card = s.href && s.href !== '#' ? 'a' : 'div';
          return (
          <Card class="qcard" href={Card === 'a' ? s.href : undefined}>
            <Icon name={s.icon} size={32} class="qcard__icon" />
            <span class="qcard__body">
              <span class="qcard__label">
                {s.label}
                {s.live && <span class="live">živě</span>}
              </span>
              {s.live ? (
                <>
                  <span class="qcard__value">
                    <span data-debt-amount data-amount={debt.amount} data-measured-at={debt.measuredAt} data-per-day={debt.perDay}>
                      {formatNumber(debt.amount)}
                    </span>
                    <span class="unit">{s.unit}</span>
                  </span>
                  <span class="qcard__sub qcard__sub--alert">
                    + <span data-debt-since>0</span> kč {s.sub}
                  </span>
                </>
              ) : (
                <>
                  <span class:list={['qcard__value', { 'qcard__value--todo': s.value === null }]}>
                    {s.value ?? 'doplníme'}
                    {s.value !== null && <span class="unit">{s.unit}</span>}
                  </span>
                  <span class="qcard__sub">{s.sub}</span>
                </>
              )}
            </span>
            {Card === 'a' && <Icon name="ArrowRight" size={22} class="qcard__arrow" />}
          </Card>
          );
        })
      }
    </div>
    <div class="hero__dotsnav" aria-label="Karty">
      {heroStats.map((st, i) => <button type="button" aria-label={st.label} aria-current={i === 0 ? 'true' : 'false'} />)}
    </div>
  </div>
</section>

<script>
  // Tečky pod kartami (telefon): zvýrazní právě viditelnou kartu, kliknutím na ni posunou.
  const track = document.querySelector<HTMLElement>('.hero__cards');
  const dots = [...document.querySelectorAll<HTMLButtonElement>('.hero__dotsnav button')];
  if (track && dots.length) {
    const cards = [...track.children] as HTMLElement[];
    const offset = (i: number) => cards[i].offsetLeft - cards[0].offsetLeft;
    const update = () => {
      // Poslední karta se nedá doscrollovat až k levému okraji, proto konec = poslední.
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      const step = offset(1) || 1;
      const current = atEnd ? cards.length - 1 : Math.round(track.scrollLeft / step);
      dots.forEach((d, j) => d.setAttribute('aria-current', String(current === j)));
    };
    track.addEventListener('scroll', update, { passive: true });
    dots.forEach((d, i) => d.addEventListener('click', () => track.scrollTo({ left: offset(i), behavior: 'smooth' })));
  }

  // Odhad dluhu v tuto chvíli: výchozí částka + denní přírůstek od data měření (princip statnidluh).
  const amountEl = document.querySelector<HTMLElement>('[data-debt-amount]');
  const sinceEl = document.querySelector<HTMLElement>('[data-debt-since]');
  if (amountEl) {
    const amount = Number(amountEl.dataset.amount);
    const measuredAt = Date.parse(amountEl.dataset.measuredAt ?? '');
    const perMs = Number(amountEl.dataset.perDay) / 86_400_000;
    const openedAt = Date.now();
    const fmt = new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 0 });
    const tick = () => {
      const now = Date.now();
      amountEl.textContent = fmt.format(amount + (now - measuredAt) * perMs);
      if (sinceEl) sinceEl.textContent = fmt.format((now - openedAt) * perMs);
    };
    tick();
    // Jednou za sekundu – častější přepis dělá z posledních číslic neklidné blikání.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(tick, 1000);
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 40px;
    background: var(--bg);
  }

  @media (min-width: 48em) {
    .hero {
      padding: 120px 0 56px;
    }
  }

  /* Tečkovaná mřížka z Frameru, ke krajům mizí – a dole vymizí nad kartami, ve stejném pásu
     jako spodek fotky lidí. */
  .hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.09) 1.2px, transparent 1.6px);
    background-size: 22px 22px;
    mask-image:
      radial-gradient(ellipse 70% 60% at 50% 35%, #000 30%, transparent 100%),
      linear-gradient(#000 55%, transparent 79%);
    mask-composite: intersect;
    pointer-events: none;
  }

  /* Naklopené značky Voluntie v pozadí (žlutá a šedá, 60% krytí). */
  .hero :global(.mark) {
    position: absolute;
    pointer-events: none;
    height: auto;
    opacity: 0.6;
  }
  .hero :global(.mark--yellow) {
    left: -250px;
    bottom: 40px;
    width: 420px;
    color: var(--yellow);
    transform: rotate(-10deg);
  }
  .hero :global(.mark--grey) {
    right: -120px;
    top: 10px;
    width: 400px;
    color: #3a3a3a;
    transform: rotate(12deg);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 56px;
  }

  @media (min-width: 48em) {
    .hero__inner {
      row-gap: 96px;
    }
  }

  /* Na počítači heslo vlevo, lidé vpravo, karty pod tím přes celou šířku. */
  @media (min-width: 62em) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      column-gap: 32px;
      align-items: center;
    }
    .hero__cards {
      grid-column: 1 / -1;
    }
  }

  /* Na telefonu a tabletu (bez fotky) na střed, na počítači vlevo vedle fotky. */
  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__actions {
    justify-content: center;
  }

  @media (min-width: 62em) {
    .hero__intro {
      align-items: flex-start;
      text-align: left;
    }
    .hero__actions {
      justify-content: flex-start;
    }
  }

  .hero__news {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 40px;
    padding: 5px 14px 5px 5px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--chip);
    color: var(--text-soft);
    font-size: var(--fs-note);
    font-weight: 500;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .hero__news:hover {
    border-color: var(--yellow);
    color: var(--white);
    text-decoration: none;
  }

  .hero__news-tag {
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--black);
    font-size: 12px;
    font-weight: 700;
  }

  .hero__title {
    margin: 0 0 36px;
    /* Na telefonu vyplní „více svobody“ (≈ 6,2 em) šířku obsahu, na počítači podle šířky okna. */
    font-size: clamp(40px, calc((100vw - 2 * var(--gutter)) / 6.3), 88px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  @media (min-width: 62em) {
    .hero__title {
      font-size: clamp(48px, 6.4vw, 88px);
    }
  }

  .hero__title span {
    display: block;
    color: var(--yellow);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__intro :global(.hero__socials) {
    margin-top: 28px;
  }

  /* Skupinová fotka: bez rámečku, usazená dole na kartách. Spodek (fotky končí v pase)
     mizí ve stejném pásu jako tečkovaná mřížka – lidé vyrůstají z jejího přechodu.
     Jen na počítači, na užších obrazovkách by fotka pod textem zabrala celou obrazovku. */
  .hero__people {
    display: none;
  }

  @media (min-width: 62em) {
    .hero__people {
      display: block;
      position: relative;
      align-self: end;
      margin: -40px -24px -96px -8px;
    }
  }

  .hero__people :global(img) {
    display: block;
    width: 100%;
    height: auto;
    mask-image: linear-gradient(#000 62%, transparent 100%);
  }

  /* Tři nízké karty – rámeček jako karta IS, obsah jako metrika statnidluh. */
  /* Na telefonu a tabletu se mezi kartami listuje do stran (karta má šířku obsahu stránky,
     posouvá se až k okraji obrazovky), pozici ukazují tečky pod nimi. */
  .hero__cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 12px;
    margin: 0 calc(-1 * var(--gutter));
    padding: 0 var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--gutter);
    scrollbar-width: none;
  }

  .hero__cards::-webkit-scrollbar {
    display: none;
  }

  .hero__cards > :global(*) {
    scroll-snap-align: start;
  }

  @media (min-width: 48em) and (max-width: 61.99em) {
    .hero__cards {
      grid-auto-columns: 46%;
    }
    .hero__dotsnav {
      margin-top: -80px;
    }
  }

  .hero__dotsnav {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: -40px;
  }

  .hero__dotsnav button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    transition: width var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .hero__dotsnav button[aria-current='true'] {
    width: 22px;
    background: var(--yellow);
  }

  @media (min-width: 62em) {
    .hero__cards {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
    .hero__dotsnav {
      display: none;
    }
  }

  .qcard {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: rgb(18 18 18 / 0.85);
    backdrop-filter: blur(6px);
    color: var(--white);
    transition: border-color var(--dur) var(--ease);
  }

  a.qcard:hover {
    border-color: var(--yellow);
    text-decoration: none;
  }

  .qcard :global(.qcard__icon) {
    color: var(--yellow);
    flex: none;
  }

  .qcard__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
  }

  .qcard__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--alert);
    font-weight: 700;
  }

  .live::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 2.4s ease-in-out infinite;
  }

  /* Klidné „dýchání“, ne blikání. */
  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }

  .qcard__value {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .qcard__value {
    font-variant-numeric: tabular-nums;
  }

  .qcard__value--todo {
    color: var(--dim);
    font-style: italic;
  }

  .unit {
    margin-left: 0.2em;
    font-size: 0.6em;
    color: var(--yellow);
  }

  .qcard__sub {
    font-size: 13px;
    color: var(--muted);
  }

  .qcard__sub--alert {
    color: var(--alert);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .qcard :global(.qcard__arrow) {
    flex: none;
    color: var(--dim);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .qcard:hover :global(.qcard__arrow) {
    color: var(--yellow);
    transform: translateX(2px);
  }

  @media (max-width: 47.99em) {
    .hero :global(.mark--yellow) {
      width: 230px;
      left: -150px;
      bottom: 380px;
    }
    .hero :global(.mark--grey) {
      width: 220px;
      right: -95px;
    }
  }

</style>
