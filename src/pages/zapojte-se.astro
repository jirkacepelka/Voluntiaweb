---
// Rozcestník „Zapojte se“: čtyři role vedle sebe. Inspirované IS (štítek s cenou, výhody
// s ikonami, žlutý odkaz se šipkou), texty zkrácené z popisů rolí v IS.
// Kandidát zatím nemá vlastní přihlášku („Připravujeme“).
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import { contact, links } from '../config';

type IconName = 'Key' | 'Ear' | 'UserPlus' | 'Megaphone' | 'Newspaper' | 'BicepsFlexed' | 'Users' | 'AudioLines' | 'Phone' | 'LogIn';

interface Role {
  id: string;
  icon: 'HandHeart' | 'HandHelping' | 'Vote' | 'HandCoins';
  title: string;
  badge: string;
  soon?: boolean;
  lead: string;
  features: { icon: IconName; text: string }[];
  cta: { label: string; href: string };
}

const roles: Role[] = [
  {
    id: 'priznivec',
    icon: 'HandHeart',
    title: 'Příznivec',
    badge: '100 Kč/měsíc',
    lead: 'Podporujete stranu bez formální odpovědnosti člena.',
    features: [
      { icon: 'Key', text: 'Přístup do diskusí a akcí' },
      { icon: 'Ear', text: 'Pravidelné zprávy o dění' },
      { icon: 'UserPlus', text: 'Po roce cesta ke členství' },
    ],
    cta: { label: 'Stát se příznivcem', href: links.supporter },
  },
  {
    id: 'dobrovolnik',
    icon: 'HandHelping',
    title: 'Dobrovolník',
    badge: 'Zdarma',
    lead: 'Pomáháte svým časem – v terénu i on-line.',
    features: [
      { icon: 'Megaphone', text: 'Kampaně a akce' },
      { icon: 'Newspaper', text: 'Samolepky, plakáty, propagace' },
      { icon: 'BicepsFlexed', text: 'Zkušenosti z politiky' },
    ],
    cta: { label: 'Stát se dobrovolníkem', href: links.volunteer },
  },
  {
    id: 'kandidat',
    icon: 'Vote',
    title: 'Kandidát',
    badge: 'Připravujeme',
    soon: true,
    lead: 'Jste ochotní jít na kandidátku? Ozveme se před volbami.',
    features: [
      { icon: 'Phone', text: 'Kontakt před volbami' },
      { icon: 'LogIn', text: 'Zápis na kandidátku v IS' },
    ],
    cta: { label: 'Napsat nám', href: `mailto:${contact.email}` },
  },
  {
    id: 'prispevatel',
    icon: 'HandCoins',
    title: 'Přispěvatel',
    badge: '50–200 Kč/měsíc',
    lead: 'Pravidelně financujete dlouhodobý rozvoj Voluntie.',
    features: [
      { icon: 'Ear', text: 'Přehled, kam peníze šly' },
      { icon: 'Users', text: 'Role na Discordu' },
      { icon: 'AudioLines', text: 'Diskuse o programu' },
    ],
    cta: { label: 'Stát se přispěvatelem', href: links.contributor },
  },
];
---

<Base title="Zapojte se" description="Jak se zapojit do Libertariánské strany Voluntia: příznivec, dobrovolník, kandidát nebo přispěvatel.">
  <div class="container page">
    <Crumbs items={[{ label: 'Úvod', href: '/' }, { label: 'Zapojte se' }]} />
    <h1 class="page-title">Zapojte se</h1>
    <p class="lede">Pomozte nám bránit sociální a ekonomickou svobodu v ČR. Vyberte si, jak chcete být u toho.</p>

    <ul class="roles">
      {
        roles.map((r) => (
          <li class:list={['role', { 'role--soon': r.soon }]} id={r.id}>
            <div class="role__head">
              <Icon name={r.icon} size={28} class="role__icon" />
              <span class="role__badge">{r.badge}</span>
            </div>
            <h2>{r.title}</h2>
            <p class="role__lead">{r.lead}</p>
            <ul class="role__features">
              {r.features.map((f) => (
                <li>
                  <Icon name={f.icon} size={18} class="role__ficon" />
                  {f.text}
                </li>
              ))}
            </ul>
            <a class="role__cta" href={r.cta.href}>
              {r.cta.label} <Icon name="ArrowRight" size={18} />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Komunita: nejnižší práh, jak se zapojit – proto výrazněji než role. -->
    <section class="community" aria-labelledby="komunita-title">
      <Icon name="MessagesSquare" size={40} class="community__icon" />
      <div class="community__text">
        <h2 id="komunita-title">Nejdřív se rozhlédnout? Přijďte na Discord</h2>
        <p>Diskuse, akce i domluva dobrovolníků. Přidat se může každý, i bez členství.</p>
      </div>
      <div class="community__actions">
        <a class="btn btn--primary" href={links.discord}>Připojit se na Discord</a>
        {links.forum !== '#' && <a class="btn btn--ghost" href={links.forum}>Voluntia Forum</a>}
      </div>
    </section>
  </div>
</Base>

<style>
  .roles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48em) {
    .roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }
  /* Celá karta je klikací (odkaz CTA se roztáhne přes ni) a při najetí lehce povyskočí. */
  .role {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 12px;
    background: var(--card);
    scroll-margin-top: calc(var(--header-h) + 24px);
    transition: background-color var(--dur) var(--ease), transform 250ms var(--ease);
  }
  .role:hover {
    background: var(--card-hover);
    transform: translateY(-3px);
  }
  .role:has(.role__cta:focus-visible) {
    outline: 2px solid var(--yellow);
    outline-offset: 2px;
  }
  .role__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .role__cta:focus-visible {
    outline: none;
  }
  @media (min-width: 48em) {
    .role {
      padding: 28px 28px 26px;
    }
  }

  .role__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }
  .role :global(.role__icon) {
    color: var(--yellow);
  }
  /* Štítek s cenou – jako v IS. */
  .role__badge {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    background: var(--yellow);
    color: var(--black);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  .role h2 {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.025em;
  }
  .role__lead {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .role__features {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .role__features li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    font-size: var(--fs-small);
    line-height: 1.4;
    font-weight: 700;
    color: var(--white);
  }
  .role__features :global(.role__ficon) {
    margin-top: 1px;
    color: var(--yellow);
  }

  .role__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 24px;
    color: var(--yellow);
    font-size: 17px;
    font-weight: 700;
  }
  /* Na širokém desktopu všechny čtyři role vedle sebe, ať jsou vidět najednou.
     Subgrid zarovná nadpisy, linky i odkazy napříč kartami. */
  @media (min-width: 72em) {
    .roles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 32px;
    }
    .role {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 5;
      row-gap: 0;
      padding: 24px 24px 22px;
    }
    .role__head {
      margin-bottom: 16px;
    }
    .role h2 {
      font-size: 22px;
    }
    .role__lead {
      font-size: 14px;
    }
    .role__features {
      align-content: start;
    }
    .role__cta {
      padding-top: 20px;
    }
  }

  .role__cta:hover {
    text-decoration: none;
  }
  .role:hover .role__cta :global(svg) {
    transform: translateX(3px);
  }
  .role__cta :global(svg) {
    transition: transform var(--dur) var(--ease);
  }
  .role__cta:hover :global(svg) {
    transform: translateX(3px);
  }

  /* Kandidát zatím bez přihlášky – tlumeně. */
  .role--soon .role__badge {
    background: var(--field);
    color: var(--muted);
  }
  .role--soon :global(.role__icon) {
    color: var(--dim);
  }

  /* Discord + fórum: výrazný pás pod rolemi přes celou šířku. */
  .community {
    display: grid;
    gap: 16px 24px;
    align-items: center;
    margin: 32px 0 0;
    padding: 24px;
    border-radius: 12px;
    background: var(--card);
  }
  @media (min-width: 48em) {
    .community {
      grid-template-columns: auto minmax(0, 1fr) auto;
      padding: 24px 28px;
    }
  }
  .community :global(.community__icon) {
    color: var(--yellow);
  }
  .community h2 {
    margin: 0 0 4px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .community p {
    margin: 0;
    color: var(--muted);
  }
  .community__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
