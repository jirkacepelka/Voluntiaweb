---
// Výpis článků s vyhledáváním a filtry (rubrika, rok). Všechny články jsou ve stránce,
// hledání a filtr běží v prohlížeči (statický web), postupně se ukazuje po 12 článcích.
// Bez JavaScriptu se zobrazí všechny články bez ovládání.
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import { cms } from '../../lib/cms';

const PAGE_SIZE = 12;
const articles = await cms.listArticles();

// Filtry: rubriky (podle počtu článků) a roky (od nejnovějšího). Skupina se ukáže,
// jen když má aspoň dvě možnosti – dnes mají všechny články z WordPressu jednu rubriku.
const counts = new Map<string, { name: string; count: number }>();
for (const a of articles) {
  if (!a.category) continue;
  const c = counts.get(a.category.slug) ?? { name: a.category.name, count: 0 };
  c.count++;
  counts.set(a.category.slug, c);
}
const year = (iso: string) => String(new Date(iso).getFullYear());
const filters = [
  {
    key: 'rubrika',
    label: 'Rubrika',
    options: [...counts.entries()].sort((a, b) => b[1].count - a[1].count).map(([value, c]) => ({ value, label: c.name })),
  },
  {
    key: 'rok',
    label: 'Rok',
    options: [...new Set(articles.map((a) => year(a.publishedAt)))].sort((a, b) => b.localeCompare(a)).map((y) => ({ value: y, label: y })),
  },
].filter((f) => f.options.length > 1);

const normalize = (s: string) =>
  s
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase();
---

<Base title="Články" description="Články, tiskové zprávy a komentáře Libertariánské strany Voluntia.">
  <div class="container page">
    <Crumbs items={[{ label: 'Úvod', href: '/' }, { label: 'Články' }]} />
    <h1 class="page-title">Články</h1>

    <div class="toolbar" data-toolbar hidden>
      <label class="search">
        <span class="sr-only">Hledat v článcích</span>
        <Icon name="Search" size={20} class="search__icon" />
        <input type="search" name="q" placeholder="Hledat v článcích…" autocomplete="off" data-search />
      </label>
      {
        filters.map((f) =>
          f.key === 'rok' ? (
            <label class="select">
              <span class="sr-only">{f.label}</span>
              <select data-filter={f.key}>
                <option value="">Všechny roky</option>
                {f.options.map((o) => (
                  <option value={o.value}>{o.label}</option>
                ))}
              </select>
              <Icon name="ChevronDown" size={18} class="select__icon" />
            </label>
          ) : (
            <div class="tabs filters" role="group" aria-label={f.label} data-filter={f.key}>
              <button class="tab" type="button" data-value="" aria-pressed="true">
                Vše
              </button>
              {f.options.map((o) => (
                <button class="tab" type="button" data-value={o.value} aria-pressed="false">
                  {o.label}
                </button>
              ))}
            </div>
          ),
        )
      }
    </div>

    <p class="status" data-status aria-live="polite"></p>

    <ul class="grid-3" data-list>
      {
        articles.map((a) => (
          <li data-rubrika={a.category?.slug ?? ''} data-rok={year(a.publishedAt)} data-text={normalize([a.title, a.excerpt, a.category?.name ?? ''].join(' '))}>
            <ArticleCard article={a} />
          </li>
        ))
      }
    </ul>

    <div class="empty" data-empty hidden>
      <p>Žádný článek neodpovídá hledání ani filtrům.</p>
      <button class="btn btn--ghost" type="button" data-reset>Zrušit filtry</button>
    </div>

    <div class="more" data-more hidden>
      <button class="btn btn--ghost" type="button">Zobrazit další <Icon name="ArrowDown" size={18} /></button>
    </div>
  </div>
</Base>

<script is:inline define:vars={{ PAGE_SIZE }}>
  const toolbar = document.querySelector('[data-toolbar]');
  const input = document.querySelector('[data-search]');
  const items = [...document.querySelectorAll('[data-list] > li')];
  const groups = [...document.querySelectorAll('[data-filter]')];
  const status = document.querySelector('[data-status]');
  const empty = document.querySelector('[data-empty]');
  const more = document.querySelector('[data-more]');

  const normalize = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
  const plural = (n) => (n === 1 ? 'článek' : n >= 2 && n <= 4 ? 'články' : 'článků');
  // Filtr je buď skupina tlačítek (rubrika), nebo rozbalovací seznam (rok).
  const isSelect = (g) => g.tagName === 'SELECT';
  const buttonsOf = (g) => (isSelect(g) ? [] : [...g.querySelectorAll('button')]);
  const valuesOf = (g) => (isSelect(g) ? [...g.options].map((o) => o.value) : buttonsOf(g).map((b) => b.dataset.value));

  // Stav: hledaný text a vybraná hodnota každého filtru (z adresy, ať jde odkaz sdílet).
  const params = new URLSearchParams(location.search);
  let query = params.get('q') ?? '';
  const selected = {};
  for (const g of groups) {
    const v = params.get(g.dataset.filter) ?? '';
    selected[g.dataset.filter] = valuesOf(g).includes(v) ? v : '';
  }
  let limit = PAGE_SIZE;

  input.value = query;
  toolbar.hidden = false;

  function render() {
    const words = normalize(query).split(/\s+/).filter(Boolean);
    const matches = items.filter(
      (li) =>
        Object.entries(selected).every(([key, v]) => !v || li.dataset[key] === v) &&
        words.every((w) => li.dataset.text.includes(w)),
    );
    items.forEach((li) => (li.hidden = true));
    matches.slice(0, limit).forEach((li) => (li.hidden = false));

    for (const g of groups) {
      if (isSelect(g)) g.value = selected[g.dataset.filter];
      buttonsOf(g).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === selected[g.dataset.filter])));
    }
    const filtered = words.length > 0 || Object.values(selected).some(Boolean);
    status.textContent = filtered && matches.length ? `Nalezeno ${matches.length} ${plural(matches.length)}` : '';
    empty.hidden = matches.length > 0;
    more.hidden = matches.length <= limit;

    const url = new URL(location.href);
    query.trim() ? url.searchParams.set('q', query.trim()) : url.searchParams.delete('q');
    for (const [key, v] of Object.entries(selected)) v ? url.searchParams.set(key, v) : url.searchParams.delete(key);
    history.replaceState(null, '', url);
  }

  input.addEventListener('input', () => {
    query = input.value;
    limit = PAGE_SIZE;
    render();
  });
  for (const g of groups) {
    if (isSelect(g))
      g.addEventListener('change', () => {
        selected[g.dataset.filter] = g.value;
        limit = PAGE_SIZE;
        render();
      });
    buttonsOf(g).forEach((b) =>
      b.addEventListener('click', () => {
        selected[g.dataset.filter] = b.dataset.value;
        limit = PAGE_SIZE;
        render();
      }),
    );
  }
  more.querySelector('button').addEventListener('click', () => {
    limit += PAGE_SIZE;
    render();
  });
  document.querySelector('[data-reset]').addEventListener('click', () => {
    query = input.value = '';
    for (const key of Object.keys(selected)) selected[key] = '';
    render();
    input.focus();
  });

  render();
</script>

<style>
  .toolbar {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-bottom: 40px;
  }
  .toolbar[hidden] {
    display: none;
  }

  .search {
    position: relative;
    flex: 1 1 320px;
    max-width: 440px;
  }
  .search :global(.search__icon) {
    position: absolute;
    top: 50%;
    left: 16px;
    color: var(--dim);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 46px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--field);
    color: var(--white);
    font: inherit;
    font-size: 16px;
    transition: border-color var(--dur) var(--ease);
  }
  .search input::placeholder {
    color: var(--dim);
  }
  .search input:hover {
    border-color: var(--border);
  }
  .search input:focus {
    border-color: var(--yellow);
    outline: none;
  }

  .filters {
    margin: 0;
  }

  .select {
    position: relative;
    flex: none;
  }
  .select select {
    height: 48px;
    padding: 0 44px 0 16px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--field);
    color: var(--white);
    font: inherit;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    appearance: none;
    transition: border-color var(--dur) var(--ease);
  }
  .select select:hover {
    border-color: var(--border);
  }
  .select select:focus {
    border-color: var(--yellow);
    outline: none;
  }
  .select option {
    background: var(--field);
    color: var(--white);
  }
  .select :global(.select__icon) {
    position: absolute;
    top: 50%;
    right: 16px;
    color: var(--muted);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .filters .tab[aria-pressed='true'] {
    background: var(--yellow);
    color: var(--black);
  }

  .status {
    margin: -20px 0 24px;
    font-size: var(--fs-note);
    color: var(--muted);
  }
  .status:empty {
    display: none;
  }

  .grid-3 > li[hidden] {
    display: none;
  }

  .empty {
    padding: 48px 0;
    color: var(--muted);
  }
  .empty p {
    margin: 0 0 16px;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }
  .more[hidden],
  .empty[hidden] {
    display: none;
  }
</style>
