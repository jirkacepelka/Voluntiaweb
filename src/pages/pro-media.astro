---
// Pro média: tiskový kontakt a podklady ke stažení (logo, značka, profilovka, barvy, písmo).
// Soubory v public/brand/ generuje `npm run brand` (scripts/brand-assets.mjs).
import { statSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import AssetTile from '../components/AssetTile.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../config';

const size = (name: string) => {
  const kb = statSync(`public/brand/${name}`).size / 1024;
  return kb >= 1024 ? `${(kb / 1024).toFixed(1).replace('.', ',')} MB` : `${Math.max(1, Math.round(kb))} kB`;
};
const file = (name: string) => ({ href: `/brand/${name}`, size: size(name) });

type Tone = 'dark' | 'yellow';
const variants: { key: string; logo: string; mark: string; tone: Tone }[] = [
  { key: 'zluta', logo: 'žluté', mark: 'žlutá', tone: 'dark' },
  { key: 'bila', logo: 'bílé', mark: 'bílá', tone: 'dark' },
  { key: 'cerna', logo: 'černé', mark: 'černá', tone: 'yellow' },
];

const logos = variants.map((v) => ({
  title: `Logo – ${v.logo}`,
  preview: `/brand/voluntia-logo-${v.key}.svg`,
  tone: v.tone,
  wide: true,
  files: [
    { label: 'SVG', ...file(`voluntia-logo-${v.key}.svg`) },
    { label: 'PNG', ...file(`voluntia-logo-${v.key}.png`) },
  ],
}));

const marks = [
  ...variants.map((v) => ({
    title: `Značka – ${v.mark}`,
    preview: `/brand/voluntia-znacka-${v.key}.svg`,
    tone: v.tone,
    files: [
      { label: 'SVG', ...file(`voluntia-znacka-${v.key}.svg`) },
      { label: 'PNG', ...file(`voluntia-znacka-${v.key}.png`) },
    ],
  })),
  {
    title: 'Profilový obrázek',
    preview: '/brand/voluntia-profilovka.png',
    tone: 'dark' as Tone,
    files: [{ label: 'PNG 1080 px', ...file('voluntia-profilovka.png') }],
  },
];

const colors = [
  { name: 'Žlutá Voluntia', hex: '#FED801', use: 'Logo, tlačítka, akcenty', darkText: true },
  { name: 'Černá', hex: '#000000', use: 'Horní lišta, logo na žluté' },
  { name: 'Šedá', hex: '#121212', use: 'Pozadí' },
  { name: 'Bílá', hex: '#FFFFFF', use: 'Nadpisy a text', darkText: true },
];
const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ');

const weights = [
  { weight: 800, name: 'ExtraBold 800', use: 'Logo a nadpisy' },
  { weight: 700, name: 'Bold 700', use: 'Nadpisy karet a zvýraznění' },
  { weight: 600, name: 'SemiBold 600', use: 'Tlačítka a menu' },
  { weight: 400, name: 'Regular 400', use: 'Text' },
];

const zip = file('voluntia-brand.zip');
---

<Base title="Pro média" description="Tiskový kontakt a podklady ke stažení: logo, značka, barvy a písmo Libertariánské strany Voluntia.">
  <div class="container page">
    <Crumbs items={[{ label: 'Úvod', href: '/' }, { label: 'Pro média' }]} />
    <h1 class="page-title">Pro média</h1>
    <p class="lede">Tiskový kontakt a podklady pro každého, kdo o Voluntii píše, natáčí nebo ji odkazuje.</p>


    <section class="block" aria-labelledby="assets-title">
      <div class="block__head">
        <div>
          <h2 id="assets-title" class="sub">Logo a značka</h2>
          <p>
            Používejte je volně v článcích, reportážích i prezentacích – jen logo neupravujte a nevydávejte za vlastní. SVG je vektor
            pro tisk i web, PNG má průhledné pozadí.
          </p>
        </div>
        <a class="btn btn--primary" href={zip.href} download>
          <Icon name="Download" size={18} /> Stáhnout vše <span class="btn__meta">ZIP · {zip.size}</span>
        </a>
      </div>

      <ul class="assets assets--wide">
        {logos.map((a) => <AssetTile {...a} />)}
      </ul>
      <ul class="assets">
        {marks.map((a) => <AssetTile {...a} />)}
      </ul>

      <ul class="rules">
        <li><Icon name="Check" size={18} /> Kolem loga nechte volné místo aspoň o výšce štítku „Libertariánská strana“.</li>
        <li><Icon name="Check" size={18} /> Na tmavém podkladu použijte žlutou nebo bílou verzi, na žlutém a světlém černou.</li>
        <li><Icon name="X" size={18} /> Logo nedeformujte, neotáčejte, nepřebarvujte a nepřidávejte mu efekty.</li>
      </ul>
    </section>

    <section class="block" aria-labelledby="colors-title">
      <h2 id="colors-title" class="sub">Barvy</h2>
      <p>Značku nese žlutá, ostatní barvy ustupují obsahu. Kliknutím zkopírujete HEX.</p>
      <ul class="colors">
        {
          colors.map((c, i) => (
            <li class:list={[i === 0 ? 'colors__main' : 'colors__side']}>
              <button class="color" type="button" data-copy={c.hex}>
                <span class:list={['color__swatch', { 'color__swatch--dark-text': c.darkText }]} style={`background:${c.hex}`}>
                  <span class="color__copied">Zkopírováno</span>
                </span>
                <span class="color__text">
                  <span class="color__name">{c.name}</span>
                  <span class="color__hex">{c.hex}</span>
                  <span class="color__meta">
                    RGB {rgb(c.hex)} · {c.use}
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="font-title">
      <h2 id="font-title" class="sub">Písmo</h2>
      <p>Celý web i logo jsou sázené jedním písmem, Inter. Je zdarma pod licencí SIL Open Font License, včetně komerčního použití.</p>
      <div class="font">
        <div class="font__sample">
          <span class="font__aa">Aa</span>
          <span class="font__name">Inter</span>
          <span class="font__meta">Rasmus Andersson · SIL Open Font License 1.1</span>
          <span class="font__links">
            <a href="https://fonts.google.com/specimen/Inter">Google Fonts</a>
            <a href="https://rsms.me/inter/">rsms.me/inter</a>
          </span>
        </div>
        <ul class="font__weights">
          {
            weights.map((w) => (
              <li>
                <span class="font__weight">
                  {w.name} · {w.use}
                </span>
                <span class="font__pangram" style={`font-weight:${w.weight}`}>
                  Příliš žluťoučký kůň úpěl ďábelské ódy
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="block press" aria-labelledby="press-title">
      <div>
        <h2 id="press-title" class="sub">Tiskový kontakt</h2>
        <p>S dotazy médií, žádostmi o rozhovor nebo vyjádření se obracejte na</p>
        <a class="press__mail" href={`mailto:${contact.mediaEmail}`}>
          <Icon name="Mail" size={22} />
          {contact.mediaEmail}
        </a>
      </div>
      <dl class="press__facts">
        <div><dt>Oficiální název</dt><dd>{contact.name}</dd></div>
        <div><dt>Zkrácený název</dt><dd>Voluntia</dd></div>
        <div><dt>IČ</dt><dd>{contact.ico}</dd></div>
        <div><dt>Obecný kontakt</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      </dl>
    </section>
  </div>
</Base>

<script>
  // Kopírování HEX kliknutím na barvu.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.classList.add('is-copied');
        setTimeout(() => btn.classList.remove('is-copied'), 1400);
      } catch {
        // Schránka není dostupná – HEX je vidět v textu.
      }
    }),
  );
</script>

<style>
  .press {
    display: grid;
    gap: 24px 48px;
    padding: 28px;
    border-radius: 12px;
    background: var(--card);
  }
  @media (min-width: 62em) {
    .press {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      padding: 32px;
    }
  }
  .press p {
    margin: 0 0 14px;
    color: var(--muted);
  }
  .press__mail {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--white);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .press__mail :global(svg) {
    flex: none;
    color: var(--yellow);
  }
  .press__mail:hover {
    color: var(--yellow);
    text-decoration: none;
  }
  .press__facts {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  .press__facts div {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 12px;
    font-size: var(--fs-small);
  }
  .press__facts dt {
    color: var(--muted);
  }
  .press__facts dd {
    margin: 0;
    color: var(--white);
    font-weight: 600;
  }
  .press__facts a {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-underline-offset: 3px;
  }

  .sub {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--yellow);
  }
  .block {
    margin-top: 96px;
  }
  .block:first-of-type {
    margin-top: 64px;
  }
  .block > p,
  .block__head p {
    max-width: 720px;
    margin: 0;
    color: var(--muted);
  }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
  }
  .btn__meta {
    font-weight: 500;
    opacity: 0.7;
  }

  .assets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .assets--wide {
    grid-template-columns: 1fr;
  }
  @media (min-width: 48em) {
    .assets {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
    .assets--wide {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .assets + .assets {
    margin-top: 20px;
  }

  .rules {
    display: grid;
    gap: 10px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .rules li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .rules :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--yellow);
  }

  /* Žlutá jako dominantní barva vlevo, ostatní tři menší vpravo pod sebou. */
  .colors {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48em) {
    .colors {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      grid-template-rows: repeat(3, auto);
      gap: 16px 20px;
    }
    .colors__main {
      grid-row: 1 / span 3;
    }
  }
  .colors li {
    display: flex;
  }
  .color {
    display: flex;
    gap: 14px 16px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .colors__main .color {
    flex-direction: column;
  }
  .colors__side .color {
    align-items: center;
  }
  .color__swatch {
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: var(--white);
  }
  .colors__main .color__swatch {
    flex: 1;
    min-height: 200px;
  }
  .colors__side .color__swatch {
    width: 96px;
    height: 72px;
  }
  .color__swatch--dark-text {
    color: var(--black);
  }
  .color__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .color__copied {
    font-size: 13px;
    font-weight: 700;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .color.is-copied .color__copied {
    opacity: 1;
  }
  .color__name {
    font-weight: 700;
    transition: color var(--dur) var(--ease);
  }
  .color:hover .color__name {
    color: var(--yellow);
  }
  .color__hex {
    color: var(--yellow);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .color__meta {
    font-size: 13px;
    color: var(--muted);
  }

  .font {
    display: grid;
    gap: 20px;
    margin-top: 32px;
  }
  @media (min-width: 62em) {
    .font {
      grid-template-columns: 260px minmax(0, 1fr);
    }
  }
  .font__sample {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 24px;
    border-radius: 12px;
    background: var(--yellow);
    color: var(--black);
  }
  .font__aa {
    font-size: 72px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .font__name {
    margin-top: 12px;
    font-size: 20px;
    font-weight: 800;
  }
  .font__meta {
    font-size: 13px;
  }
  .font__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: auto;
    padding-top: 20px;
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .font__links a {
    color: var(--black);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .font__weights {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: 12px;
    background: var(--card);
  }
  .font__weights li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 16px 22px;
  }
  .font__weights li + li {
    border-top: 1px solid var(--border);
  }
  .font__weight {
    font-size: 13px;
    color: var(--muted);
  }
  .font__pangram {
    overflow: hidden;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
