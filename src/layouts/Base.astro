---
// Inter hostujeme lokálně (stejně jako IS) – návštěvníci neposílají IP adresu Googlu.
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Libertariánská strana Voluntia – méně státu, více svobody.',
  image,
} = Astro.props;
const fullTitle = title ? `${title} — Voluntia` : 'Voluntia — méně státu, více svobody';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Voluntia" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Přeskočit na obsah</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Jemné vyjetí karet a sekcí při scrollování (styly .reveal v global.css).
      // Inline na konci <body>, ať se obsah schová ještě před prvním vykreslením.
      (() => {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const main = document.getElementById('main');
        if (!main) return;
        // Položky mřížek a seznamů (karty) a sekce, které žádné takové položky nemají.
        const items = [...main.querySelectorAll('ul[class] > li, ol[class] > li')].filter((el) => !el.closest('nav'));
        const blocks = [...main.querySelectorAll('section')].filter(
          (el) => !items.some((i) => el.contains(i) || i.contains(el)),
        );
        const targets = [...items, ...blocks];
        if (!targets.length) return;
        items.forEach((el) => el.classList.add('reveal'));
        blocks.forEach((el) => el.classList.add('reveal', 'reveal--soft'));
        document.documentElement.classList.add('reveal-on');
        const io = new IntersectionObserver(
          (entries) => {
            // Sourozence, kteří se objeví naráz, pouštíme kousek po sobě.
            const perParent = new Map();
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target;
              const i = perParent.get(el.parentElement) ?? 0;
              perParent.set(el.parentElement, i + 1);
              el.style.setProperty('--reveal-delay', `${Math.min(i, 6) * 60}ms`);
              el.classList.add('is-in');
              io.unobserve(el);
              // Po dojetí třídy uklidíme, ať zase platí vlastní přechody karet (hover).
              el.addEventListener(
                'transitionend',
                () => el.classList.remove('reveal', 'reveal--soft', 'is-in'),
                { once: true },
              );
            }
          },
          { rootMargin: '0px 0px -40px 0px' },
        );
        targets.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 12px 16px;
    border-radius: var(--radius);
    background: var(--yellow);
    color: var(--black);
    font-weight: 600;
  }
  .skip-link:focus {
    top: 16px;
  }
</style>
