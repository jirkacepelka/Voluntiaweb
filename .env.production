# Nastavení pro produkční build (Vercel i lokální `npm run build`). Nejsou tu žádná tajemství –
# token do IS (IS_API_TOKEN), až bude potřeba, patří do Environment Variables na Vercelu.
CMS_ARTICLES_SOURCE=wordpress
CMS_PAGES_SOURCE=wordpress
CMS_PROGRAM_SOURCE=wordpress
CMS_PEOPLE_SOURCE=mock
CMS_EVENTS_SOURCE=mock
IS_API_URL=https://is.voluntia.cz/api/web
WP_API_URL=https://voluntia.cz/wp-json/wp/v2
